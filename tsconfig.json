{
	"compilerOptions": {
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"declaration": true, // Optionally generate types
		"esModuleInterop": true,
		"allowSyntheticDefaultImports": true,
		"isolatedModules": true,
		"outDir": "./_publish", // Output directory
		"sourceMap": true,
		"strict": true,
		"noImplicitAny": true,
		"noImplicitOverride": true,
		"noImplicitUseStrict": false,
		"strictNullChecks": true,
	},
	"include": [
		"./index.ts"
	]
}
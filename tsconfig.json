{
    "compilerOptions": {
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "node",
        "composite": true,
        "declaration": true, // Optionally generate types
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "isolatedModules": true,

        "rootDir": "./objects",
        "outDir": "./_publish",  // Output directory
        "sourceMap": true,

        "strict": true,
        "noImplicitAny": true,
        "noImplicitOverride": true,
        "noImplicitUseStrict": false,
        "strictNullChecks": true,
        "baseUrl": ".",
    },
    "include": [
        "objects/**/*"
    ]
}